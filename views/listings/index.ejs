<% layout('/layouts/boilerplate') %>
<body>
  <h3>All Listings</h3>
  <div class="row row-cols-lg-3">
    <%for(listing of allListings){ %>
    <a href="/listings/<%= listing.id %>" style="text-decoration: none">
      <div class="card col card-listing">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing image"
        />
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b>
          </p>
          <p>&#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : "" %>/night</p>
        </div>
        <div class="card-img-overlay"></div>
      </div>
    </a>
    <%}%>
  </div>
</body>
