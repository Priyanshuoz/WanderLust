<% layout('/layouts/boilerplate') %>
<body>
  <div id="filter">
    <div class="filter">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-bed"></i>
      <p>Special Room</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-mountain-sun"></i>
      <p>Moutains</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-mountain-city"></i>
      <p>Moutains city</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-snowflake"></i>
      <p>Snowy Area</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-person-swimming"></i>
      <p>Pool bnb</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-wine-glass"></i>
      <p>Party House</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-futbol"></i>
      <p>Fun play</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-cow"></i>
      <p>Farm</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-campground"></i>
      <p>Camping</p>
    </div>
  </div>
  <div class="row row-cols-lg-3">
    <%for(listing of allListings){ %>
    <a href="/listings/<%= listing.id %>" style="text-decoration: none">
      <div class="card col card-listing">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing image"
        />
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b>
          </p>
          <p>
            &#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') :
            "" %>/night
          </p>
        </div>
        <div class="card-img-overlay"></div>
      </div>
    </a>
    <%}%>
  </div>
</body>
